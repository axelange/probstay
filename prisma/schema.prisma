// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  AGENT
}

enum Permission {
  MANAGE_USERS
  MANAGE_CONTACTS
  MANAGE_PROPERTIES
  MANAGE_RENTALS
  MANAGE_INVOICES
  MANAGE_REGISTERS
  VIEW_FINANCIALS
  // Editing the document templates (content and structure). Held by
  // SUPER_ADMIN and ADMIN; refused to Moderators by default but grantable
  // per-user through the user_permissions override.
  MANAGE_DOCUMENT_TEMPLATES
  // Editing the agency's own record — legal identity, professional licence,
  // signatory and bank details. Same default as the templates: SUPER_ADMIN
  // and ADMIN, refused to Moderators, grantable per-user.
  //
  // Deliberately not folded into MANAGE_USERS. Managing colleagues and
  // changing the IBAN printed on every contract are different powers, and one
  // should not carry the other.
  MANAGE_AGENCY
}

// The booking pipeline. Terminal states are CHECK_OUT and CANCELLED.
// The deposit / security deposit / balance stage isn't here — those
// three settle independently of the booking's progress, so they're
// tracked as separate payment statuses on Rental.
// The booking pipeline. Two hard gates, both an explicit checkbox: the
// tri-party agreement lets INQUIRY become CONTRACT (and locks the
// dates), and the signed contract lets CONTRACT become FINALISATION (and
// freezes the owner/agent snapshot). Everything past that is guided, not
// walled — the UI shows what is missing without blocking.
//
// FINALISATION holds the identity documents and the payments. CHECK_IN
// is the stay itself, where services are billed and documents attached
// (later phases). After CHECK_OUT one thing remains: the security
// deposit returned. CANCELLED is reachable from any stage.
//
// Replaces the earlier BOOKING_CONFIRMATION stage (now the gate
// checkbox) and KYC stage (now identity capture inside FINALISATION).
enum RentalBookingStatus {
  INQUIRY
  // The money stage: net owner + commission + services are settled here,
  // and validated before the contract stage opens.
  FINANCIAL
  CONTRACT
  FINALISATION
  CHECK_IN
  CHECK_OUT
  CANCELLED
}

/**
 * Which mandates a user wants to see by default. A preference, not a
 * permission: it seeds the Biens filter and nothing more, so an agent set to
 * RENTALS can still switch the visible control and see a sale. Anything that
 * must not be reached belongs in a permission or a query filter, never here.
 */
enum MandatePreference {
  RENTALS
  SALES
  BOTH
}

/**
 * How the property was presented to the tenant before signing — the agent
 * records it, and the tenant accepts it by signing the agreement, which is why
 * the contract prints the chosen one rather than three empty boxes.
 */
/**
 * Whether the acompte was entered as a figure or as a share of the client
 * total. Only the funnel reads it — every document reads the resolved amount.
 */
/**
 * Whether the commission was entered as a figure or as a share of the owner's
 * net. Only the funnel reads it — the loyer and every document read the
 * resolved amount.
 */
enum CommissionBasis {
  AMOUNT
  PERCENT
}

enum DepositBasis {
  AMOUNT
  PERCENT
}

enum PropertyPresentation {
  IN_PERSON
  THIRD_PARTY
  REMOTE
}

/** Civil status, collected for client identification (LCB-FT / TRACFIN). */
/**
 * What a client intake link asks for.
 *
 * FULL identifies the party the agency contracts with, before the contract.
 * OCCUPANTS collects only the other adults on the stay, which is a fact about
 * one booking and is usually not known until much later.
 */
enum IntakeScope {
  FULL
  OCCUPANTS
}

enum MaritalStatus {
  SINGLE
  MARRIED
  PACS
  DIVORCED
  WIDOWED
  OTHER
}

/**
 * Why the stay is happening. A location saisonnière is a holiday instrument,
 * so anything other than HOLIDAY is worth an agent seeing rather than a box
 * quietly ticked.
 */
enum StayPurpose {
  HOLIDAY
  BUSINESS
  EVENT
  OTHER
}

/**
 * The identity documents the agency accepts. Now genuinely the source of
 * truth: `contacts.idDocType` and `rental_occupants.idDocType` are this type,
 * not free text, so nothing unrecognised can reach a contract.
 */
enum IdentityDocumentType {
  PASSPORT
  ID_CARD
  DRIVING_LICENSE
  RESIDENCE_PERMIT
  /** KBIS, or the equivalent extract abroad. A company, not a person. */
  COMPANY_REGISTRATION
}

// A demande (request) is its own thing, distinct from a rental: the first
// contact from a client, which may never turn into a booking. A precise
// demande names one property with definite dates; a wide one lists
// several properties of interest, dates optional. It carries a budget,
// never a stay amount — that belongs to the rental it may become.
enum DemandeMode {
  PRECISE
  WIDE
}

// Where the request came from. Filled automatically, not chosen: direct
// when we create it ourselves, website when it arrives from the site.
enum DemandeSource {
  DIRECT
  WEBSITE
}

// Tourist tax (taxe de séjour) rate per commune, in euros per person per
// night. Reference data an Admin revises about once a year, matched to a
// property by its city name. Kept as its own table rather than a config
// blob so each rate carries who changed it and when.
model TouristTax {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city          String   @unique
  amount        Decimal  @db.Decimal(6, 2)
  updatedAt     DateTime @updatedAt
  updatedById   String?  @db.Uuid
  updatedBy     User?    @relation("TouristTaxUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("tourist_taxes")
}

/**
 * Who bears a cost incurred during the stay. It decides where the money comes
 * from: the client's caution, the owner's net, or the agency's commission.
 */
enum ExpenseBearer {
  CLIENT
  OWNER
  AGENCY
}

/** Which of the three sums a receipt belongs to. */
/**
 * What an agency-added calendar entry is. Arrivals and departures are not
 * here: those are the rentals themselves, and a copy would drift.
 */
enum CalendarEventKind {
  MAINTENANCE
  CLEANING
  VIEWING
  OWNER_STAY
  BLOCKED
  OTHER
}

enum RentalPaymentKind {
  DEPOSIT
  BALANCE
  SECURITY_DEPOSIT
}

enum RentalPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

// Only OWNER contacts may be linked as a Property's owner (enforced by
// a DB trigger, see migration). Partner/Provider are purely
// informational — used later for invoice generation, no relations yet.
// CLIENT is the business "Tenant" (the customer renting a property) —
// same concept, this is the Contact-system term for it.
// A Contact can hold more than one type at once (e.g. an Owner who is
// also a Client) — see Contact.types.
enum ContactType {
  OWNER
  CLIENT
  PARTNER
  PROVIDER
  // A prospect is someone who has only made a request and is nothing
  // else yet — not an owner, client, partner or provider. It is therefore
  // exclusive: a contact holding PROSPECT holds no other type (enforced
  // by a CHECK). On conversion of their demande they become a CLIENT.
  PROSPECT
}

// Whether a contact is a natural person or a legal entity. Set by hand in
// BSTAY — APIMO exposes no dependable person/company flag — and defaulted
// to INDIVIDUAL so nothing is presumed a company.
enum ContactKind {
  INDIVIDUAL
  COMPANY
}

// What a contact actually does. `types` says how they relate to BSTAY;
// this says their trade, which "Prestataire" alone cannot distinguish —
// a cleaner and a bailiff are not interchangeable.
//
// Identifiers are English, labels French, per the coding guidelines
// (see contact-specialty-labels.ts).
//
// Deliberately not restricted to PROVIDER: BUSINESS_INTRODUCER
// describes a Partner, not a supplier.
//
// OTHER is paired with `otherSpecialty` free text. It exists so an
// unlisted trade is recorded rather than lost in a notes field, without
// a migration for every new one.
enum ContactSpecialty {
  CLEANING
  BAILIFF
  DESIGN
  ARCHITECT
  PLUMBING
  ELECTRICAL
  HVAC
  CONSTRUCTION
  BUSINESS_INTRODUCER
  ACCOUNTING
  EVENTS
  CATERING
  TRANSPORT
  OTHER
}

// id matches the corresponding auth.users.id (Supabase Auth) — set
// explicitly when the profile is created, never auto-generated here.
model User {
  id              String           @id @db.Uuid
  email           String           @unique
  fullName        String
  role            Role
  permissions     UserPermission[]
  properties            Property[]         @relation("PropertyAgent")
  rentalsHandled        Rental[]           @relation("RentalAgent")
  rentalsAsTenantAgent  Rental[]           @relation("RentalTenantAgent")
  rentalsOwnerConfirmed Rental[]           @relation("RentalOwnerConfirmedBy")
  rentalsContractSigned Rental[]           @relation("RentalContractSignedBy")
  identityDocuments     IdentityDocument[] @relation("IdentityDocumentUploader")
  documentsGenerated    GeneratedDocument[] @relation("GeneratedDocumentAuthor")
  documentsSigned       SignedDocument[]    @relation("SignedDocumentUploader")
  intakeLinksCreated    ClientIntakeLink[]  @relation("IntakeLinkCreatedBy")
  paymentsRecorded      RentalPayment[]     @relation("RentalPaymentRecordedBy")
  calendarEvents        CalendarEvent[]     @relation("CalendarEventCreatedBy")
  expensesRecorded      RentalExpense[]     @relation("RentalExpenseRecordedBy")
  touristTaxesUpdated   TouristTax[]       @relation("TouristTaxUpdatedBy")
  agencyUpdates         Agency[]           @relation("AgencyUpdatedBy")
  demandesCreated       Demande[]          @relation("DemandeCreatedBy")
  templateVersions      DocumentTemplateVersion[] @relation("TemplateVersionAuthor")
  demandesAssigned      Demande[]          @relation("DemandeAssignedAgent")
  invitationsSent       UserInvitation[]
  // The user's own preferences — theirs to set, needing no permission, and
  // never load-bearing for access. Kept as columns rather than a JSON blob
  // while there is one: a column is typed, migratable and greppable, and a
  // second preference is cheaper to add than a blob is to unpick.
  //
  // The agency lets property; a mandat de vente is the exception, so the
  // default shows rentals.
  mandatePreference MandatePreference @default(RENTALS)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?

  @@map("users")
}

// Access to the whole application is invite-only: an email with no row
// here cannot even authenticate (enforced by the before-user-created
// auth hook). On first Google sign-in a trigger consumes the matching
// invitation and creates the User profile with the role named here.
//
// This is a separate table rather than a pre-created User row because
// User.id must equal auth.users.id, which doesn't exist until the
// person actually signs in for the first time.
//
// Gating auth on the invitation (rather than on the email domain) is
// what keeps invite and sign-in correctly ordered: if someone could
// authenticate first and be invited afterwards, the provisioning
// trigger would already have run and their invitation would never be
// consumed, stranding them with no profile.
model UserInvitation {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @unique
  role  Role

  // Staff invitations must be @b-stay.com (enforced by a CHECK).
  // isExternal exempts an address from that rule — for the developer,
  // who is not on the company Workspace. Only SUPER_ADMIN may create
  // one (enforced by RLS), so a second dev is a row, not a redeploy.
  isExternal Boolean @default(false)

  invitedBy String? @db.Uuid
  inviter   User?   @relation(fields: [invitedBy], references: [id])

  // Informational once set: the hook only ever runs on first sign-in,
  // so a consumed invitation still needs to exist for later logins.
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_invitations")
}

// Per-user grant/revoke overrides on top of a Role's baseline
// capabilities (enforced in server code). Lets an Admin adjust a
// Moderator's or Agent's access without a migration.
model UserPermission {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id])
  permission Permission
  granted    Boolean    @default(true)
  createdAt  DateTime   @default(now())

  @@unique([userId, permission])
  @@map("user_permissions")
}

model Contact {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Multi-valued: the same Contact can hold more than one type at once
  // (e.g. an Owner who is also a Client). Plain array instead of a
  // join table so reading a Contact's types never needs a second query.
  types ContactType[]

  // Trade(s). Multi-valued because one contact routinely does more than
  // one thing — the first real record created was "Graphiste /
  // Développeur web". Same array-over-join-table reasoning as `types`.
  specialties ContactSpecialty[]

  // Free text, only meaningful when `specialties` contains OTHER.
  otherSpecialty String?

  // Individual vs company. BSTAY's own call, set by hand and never touched
  // by the APIMO sync (which has no reliable person/company flag). COMPANY
  // records carry their registration + legal representative in `company`.
  kind    ContactKind     @default(INDIVIDUAL)
  company ContactCompany?

  // Civil identity of an individual, needed for rental contracts (birth,
  // nationality, identity document). BSTAY's own data — the APIMO sync
  // never writes these columns, so they survive every re-sync. A company's
  // identity lives on `company` instead; these stay empty for it.
  birthDate   DateTime? @db.Date
  birthPlace  String?
  nationality String?
  idDocType   IdentityDocumentType?
  idDocNumber String?

  // Collected for client identification (LCB-FT / TRACFIN), not for the
  // documents — nothing prints these. Held because the agency is required to
  // know who it rents to, and kept for the next booking.
  occupation    String?
  maritalStatus MaritalStatus?
  // Postal address, printed on rental documents ("demeurant …"). BSTAY's
  // own — never synced. A company's address is its registered office in
  // `company` instead.
  address     String?
  // The rest of the postal address. `address` stays the street line, which is
  // what "demeurant …" prints, so these are additions rather than a split of
  // something the documents already read.
  postalCode  String?
  city        String?
  country     String?

  // `apimoId` is the identity for anything synced from APIMO; contacts
  // created in BSTAY simply have none.
  apimoId Int? @unique

  // lastName is the only name guaranteed present: it is set on all 5052
  // APIMO contacts, whereas 730 carry no first name — surname-only and
  // company records are normal here, not corruption.
  firstName String?
  lastName  String

  // Nullable because the agency's records are genuinely incomplete: 14
  // of the 46 owners of our properties have no email, and 16 have no
  // number. Requiring either would silently leave those properties
  // owner-less, which is worse than holding a partial contact. The
  // agency is filling the gaps at source; this stops the schema being
  // the thing that blocks import meanwhile.
  //
  // email is deliberately NOT unique. A person and the company (or
  // companies) they legally represent legitimately share one address —
  // Aslan Khabliev's own contact and his SCP "Alanian Star" both carry
  // aslan@loewe.de. Uniqueness refused the second, so it was dropped (the
  // "revisit once addresses are shared" case the owners-only phase deferred).
  email String?
  phone String?
  iban          String?
  notes         String?
  properties        Property[]
  rentalsOwned      Rental[]
  rentalTenants     RentalTenant[]
  identityDocuments IdentityDocument[]
  demandes          Demande[]          @relation("DemandeProspect")
  intakeLinks       ClientIntakeLink[]
  intakeSubmissions ClientIntakeSubmission[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?

  // Supports the 'CLIENT' = any(types) lookup used by the Agent
  // contact-visibility RLS policy.
  @@index([types], map: "contacts_types_gin_idx", type: Gin)
  // Same shape of lookup: "every plumber" is an = ANY(specialties) scan.
  @@index([specialties], map: "contacts_specialties_gin_idx", type: Gin)
  @@map("contacts")
}

// Company details for a contact whose `kind` is COMPANY. A 1:1 side table
// rather than columns on Contact: these fields are only meaningful for the
// minority that are companies, and grouping them keeps Contact lean. All
// fields are optional — a foreign company legitimately has no SIREN/SIRET,
// and the registration or representative may simply not be known yet.
model ContactCompany {
  contactId String  @id @db.Uuid
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Company identity for contracts. `legalForm`, `registrationNumber` and
  // the representative's `capacity`/multi-nationality are not native APIMO
  // columns, so the agency encodes them as labelled lines in the contact's
  // private comment, which the sync parses; everything else maps from
  // structured APIMO fields. All optional and international by design —
  // the real records are Monaco/foreign, not French SIREN/SIRET.
  legalForm          String? // Forme sociale ← comment "Forme sociale"
  registrationNumber String? // N° immatriculation ← comment "Numéro d'immatriculation"
  registeredOffice   String? // Siège social ← APIMO address (+ address_more)
  // The rest of the office address, and what the entity actually does —
  // asked for identification, like the individual's occupation.
  officePostalCode   String?
  officeCity         String?
  officeCountry      String?
  mainActivity       String?

  // The legal representative — the natural person who signs. From APIMO
  // firstname/lastname and personal fields; capacity and multi-nationality
  // from the comment. Contact-level email/phone serve as their contact.
  repFirstName   String? // ← APIMO firstname
  repLastName    String? // ← APIMO lastname
  repCapacity    String? // Qualité ← comment "Qualité" / "Capacity"
  repBirthDate   DateTime? @db.Date // ← APIMO birthday_at
  repBirthPlace  String? // ← APIMO birthplace
  repNationality String? // ← comment "Nationalité(s)" else APIMO nationality
  // The representative's own trade and contact details. Distinct from the
  // company's: the same person may sign for several entities.
  repOccupation  String?
  repPhone       String?
  repEmail       String?
  // The representative's own identity document. A company has none; the person
  // who signs for it does, and they are who the obligation reaches.
  repIdDocType   IdentityDocumentType?
  repIdDocNumber String?

  // Régime parahôtelier: a company owner under this VAT regime charges 10% VAT
  // on their net rental income. When set, documents add a "TVA 10 %" line on
  // netOwnerAmount to the client total; otherwise every amount stays HT. BSTAY-
  // owned data, never touched by the APIMO sync.
  paraHotelRegime Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_companies")
}

model Property {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apimoId       Int?   @unique
  reference     Int?
  apimoAgencyId Int?

  // BSTAY's own name for the property — the one clients are shown ("Villa
  // Alba"), as opposed to APIMO's reference. The only field on this model
  // that doesn't come from APIMO, so the sync must never overwrite it.
  // Unique: two properties sharing a name would make them
  // indistinguishable to a client.
  marketingName String? @unique

  // Nullable: real APIMO data commonly has no owner assigned yet
  // (all 52 sampled step=1 properties had owner: null).
  // Must reference a Contact with type = OWNER — enforced by a DB
  // trigger (see migration), not a plain FK, since Postgres can't
  // constrain "FK to a row with a specific column value" natively.
  ownerId String?  @db.Uuid
  owner   Contact? @relation(fields: [ownerId], references: [id])

  // Our own User FK, resolved separately (e.g. by matching email)
  // since APIMO's `user.id` is a different ID space than our UUIDs.
  agentId      String? @db.Uuid
  agent        User?   @relation("PropertyAgent", fields: [agentId], references: [id])
  apimoAgentId Int?

  // Classification (APIMO reference codes — see api3.apimo.com referentiel)
  category    Int?
  subcategory Int?
  type        Int?
  subtype     Int?
  status      Int?
  step        Int?
  quality     Int?
  name        String?

  // Address / location
  address         String?
  addressMore     String?
  publishAddress  Boolean @default(false)
  country         String?
  region          String?
  regionApimoId   Int?
  city            String?
  cityApimoId     Int?
  zipcode         String?
  district        String?
  districtApimoId Int?
  latitude        Float?
  longitude       Float?
  altitude        Int?

  // Size
  areaValue Float?
  areaUnit  Int?
  areaTotal Float?
  rooms     Int?
  bedrooms  Int?
  sleeps    Int?

  // APIMO has no bathroom count. It's derived during the sync from the
  // property's areas[] and, failing that, from its descriptions — the
  // same derivation the public site uses, so both agree. Stored rather
  // than computed on read: it's expensive (regex over long descriptions)
  // and must not drift between the two systems.
  bathrooms Int?

  // Pricing
  //
  // A null priceValue is not missing data: APIMO shows those as "price on
  // demand", and the agency means it. Distinct from priceHidden, which is
  // APIMO's `price.hide` — a rate that exists but must not be published.
  // Staff see it in the ERP; anything public (the planned website API)
  // must honour the flag.
  priceValue      Decimal? @db.Decimal(12, 2)
  priceMax        Decimal? @db.Decimal(12, 2)
  priceCurrency   String?
  pricePeriod     Int?
  priceHidden     Boolean  @default(false)
  priceCommission Decimal? @db.Decimal(12, 2)
  priceDeposit    Decimal? @db.Decimal(12, 2)
  priceFees       Decimal? @db.Decimal(12, 2)

  // Condition / construction
  condition        Int?
  standing         Int?
  constructionYear Int?
  renovationYear   Int?

  // Availability
  availability String?
  availableAt  DateTime?
  deliveredAt  DateTime?

  // APIMO reference-code arrays (resolved to labels via the
  // referentiel lookup when needed, not stored as text here)
  services    Int[]

  // The security deposit this property is normally let with. BSTAY's own
  // field — APIMO's `price.deposit` is a different figure and the sync never
  // writes this one.
  //
  // It seeds a rental's own securityDepositAmount at conversion and nothing
  // more: the copy is one-way. A rental that has already been created keeps
  // the figure it was created with, because a contract may already quote it —
  // revising the property's default must never rewrite what a tenant signed.
  defaultSecurityDeposit Decimal? @db.Decimal(12, 2)

  // Arrival and departure times for this property, printed in the agreement's
  // rental terms. Per-property rather than agency-wide: a villa with a
  // caretaker and a flat with a keybox do not turn over at the same hour.
  // Stored as they are written on the document.
  checkInTime  String @default("16h00")
  checkOutTime String @default("10h00")

  // Services included with a stay, shown on the rental as "services
  // inclus". BSTAY's own field — plain labels typed by the agency, not
  // APIMO's `services` codes above (pool, aircon…). The sync never
  // writes this, so it survives every re-sync, like `marketingName`.
  includedServices String[]

  demandeProperties DemandeProperty[]
  proximities Int[]
  tags        Int[]

  url String?

  // The property's description, per language. APIMO has no description
  // field — the text lives in comments[], one entry per language
  // (en/fr/bg/ru), and the sync takes each named one. Null rather than a
  // substitute language when one is missing: a Russian description under a
  // French heading is worse than none.
  //
  // Both are named for their language rather than one being an implicit
  // default. The column used to be a bare `description` holding French, and
  // the bilingual contract was written against it on the assumption it held
  // whatever the document needed — the name is now the documentation.
  //
  // If the remaining languages are ever needed (the public-site API, an
  // owner or tenant portal), this becomes a one-to-many table.
  descriptionFr String?
  descriptionEn String?

  notes String?

  pictures PropertyPicture[]
  // Agency-added calendar entries against this villa: a caretaker's visit, a
  // pool service, an owner's own stay.
  calendarEvents CalendarEvent[]
  rentals  Rental[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@map("properties")
}

model PropertyPicture {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  apimoId    Int      @unique
  rank       Int?
  url        String
  widthMax   Int?
  heightMax  Int?
  isPanorama Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("property_pictures")
}

// The central business object — nothing financial exists outside a
// Rental. Created in the app (agents set up bookings); not synced from
// APIMO, hence no apimoId.
model Rental {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // The booking's human-readable number, printed on every document the
  // rental produces: the confirmation as "RC-0001240", the seasonal rental
  // contract as "SRC-0001240". The prefix names the document type, this
  // number names the rental — the same booking keeps one number across all
  // of its paperwork, which is what lets an owner and a tenant hold two
  // different documents and see they belong together.
  //
  // A single monotonic sequence that never resets, and one that deliberately
  // starts at 1240 rather than 1: padded to seven digits by the formatter,
  // the reference reads as an opaque file number instead of a running count,
  // so the paperwork never tells a client how many rentals BSTAY has done.
  // The offset is presentational only — nothing computes a volume from this
  // column, and nothing should.
  //
  // Assigned by the database at insert, so two agents converting demandes at
  // the same instant cannot collide; never recycled, so a cancelled rental's
  // number is retired with it rather than handed to the next booking.
  //
  // Set at creation (INQUIRY), not at signature: the number has to exist
  // before the confirmation is drafted, which happens well before anything
  // is signed. Enquiries that never convert therefore consume numbers, which
  // is another reason the series must not be read as a count.
  reference Int @unique @default(dbgenerated("nextval('rentals_reference_seq')"))

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  // Owner of record for this rental, snapshotted from the property when
  // the lease is signed (bookingStatus reaches CONTRACT) — at that
  // moment it matches the real signed document. Null before then: the
  // booking is still an enquiry or awaiting the owner, and the property
  // may yet be reassigned. Deliberately not read through property.ownerId
  // afterwards: if a property later changes hands, past rentals must
  // stay attributed to the owner they actually belonged to, or
  // historical Owner Statements silently rewrite themselves.
  // onDelete: Restrict — a snapshot that can be nulled is not a
  // snapshot. Business rules are soft-delete-only so this should never
  // fire, but a stray hard DELETE would otherwise blank the owner on
  // every past rental at once. rentals.propertyId already restricts for
  // the same reason.
  ownerId String?  @db.Uuid
  owner   Contact? @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  // Agent of record, snapshotted from the property alongside ownerId
  // when the lease is signed (CONTRACT) — same moment, same reasoning.
  // Reassigning a property must not rewrite who handled every past
  // rental of it, which is what commission is attributed against.
  //
  // This is attribution, not authorisation: who may still *edit* a
  // rental follows the property's current agent (see the rentals RLS
  // policies), because an agent taking over a property has to be able
  // to manage its in-flight bookings.
  //
  // Nullable: null until CONTRACT, and a property may have no agent even
  // then. Captured by the rentals service (see utils/rental-snapshot) —
  // there is no trigger doing it.
  agentId String? @db.Uuid
  agent   User?   @relation("RentalAgent", fields: [agentId], references: [id], onDelete: Restrict)

  // The tenant-side co-agent: the agent who handled the demande this
  // rental was converted from. When they differ from the property's agent
  // (the owner side), the two are co-agents — one represents the tenant,
  // the other the owner — and both may manage the rental. Set once at
  // conversion, from the demande's assigned agent; null for a rental with
  // no such agent (an unassigned demande converted by an admin).
  tenantAgentId String? @db.Uuid
  tenantAgent   User?   @relation("RentalTenantAgent", fields: [tenantAgentId], references: [id], onDelete: Restrict)

  tenants RentalTenant[]

  generatedDocuments GeneratedDocument[]

  // First stage is INQUIRY, labelled "Informations" in the UI: a rental
  // only exists once a demande has been converted into one, so its
  // opening stage is where the booking's information is completed before
  // the contract. (The request phase lives on the Demande entity.)
  bookingStatus RentalBookingStatus @default(INQUIRY)

  // The demande this rental was converted from, if any. The FK lives on
  // Demande (convertedRentalId); this is only the back-relation.
  originatingDemande Demande? @relation("DemandeConversion")

  // When the owner confirmed these dates, and who obtained it.
  //
  // Recorded separately from bookingStatus because BOOKING_CONFIRMATION
  // covers two different situations — "asked the owner" and "the owner
  // said yes" — and only the second is exclusive. Mandates are not
  // exclusive, so several agents may legitimately be waiting on the same
  // owner for the same week; what may not happen twice is the answer.
  //
  // This is what the no-overlap constraint keys on, not the deposit:
  // waiting for payment would lock the villa long after promises have
  // been made. It is also the agency's evidence if an owner later
  // disputes having agreed — a date and a name, not an inferred status.
  ownerConfirmedAt   DateTime?
  ownerConfirmedById String?   @db.Uuid
  ownerConfirmedBy   User?     @relation("RentalOwnerConfirmedBy", fields: [ownerConfirmedById], references: [id], onDelete: Restrict)

  // The "contract signed by all parties" gate. This is the moment the
  // booking matches a real signed document, so it — not entry into the
  // CONTRACT stage — is when the owner/agent snapshot is frozen.
  contractSignedAt   DateTime?
  contractSignedById String?   @db.Uuid
  contractSignedBy   User?     @relation("RentalContractSignedBy", fields: [contractSignedById], references: [id], onDelete: Restrict)

  // The one thing left after check-out: the security deposit handed back.
  // Sets securityDepositStatus to REFUNDED in the same action.
  securityDepositReturnedAt DateTime?
  // What was actually handed back: the caution received, less the expenses
  // charged to the client. Frozen when the agent ticks it on the departure
  // step, because that is the figure they acted on — recomputing it later from
  // expenses that have since moved would rewrite what was paid.
  securityDepositReturnedAmount Decimal? @db.Decimal(12, 2)

  // Why the stay is happening, and the other adults on it. Both asked of the
  // client through the intake link, not of the agent.
  stayPurpose      StayPurpose?
  stayPurposeOther String?
  occupants        RentalOccupant[]

  // What has actually come in, under each of the three statuses. A status
  // says "partially paid"; these say how much, and when.
  payments          RentalPayment[]
  calendarEvents    CalendarEvent[]
  // What the stay cost, and who carries each one.
  expenses          RentalExpense[]

  identityDocuments IdentityDocument[]
  intakeLinks       ClientIntakeLink[]
  intakeSubmissions ClientIntakeSubmission[]
  // The copies that came back signed, one row per upload.
  signedDocuments   SignedDocument[]
  // Extra services the agent adds and prices for this booking, on top of
  // the stay amount and the property's own included services.
  services          RentalService[]

  // Deposit, security deposit and balance settle independently of each
  // other and of the booking's stage, so each carries its own status.
  depositStatus         RentalPaymentStatus @default(UNPAID)
  securityDepositStatus RentalPaymentStatus @default(UNPAID)
  balanceStatus         RentalPaymentStatus @default(UNPAID)

  checkIn  DateTime
  checkOut DateTime

  // Number of guests the booking is for — not the number of named
  // tenants (a party of eight may have one lead contact). Drives the
  // tourist tax, which is charged per person per night. Nullable: an
  // enquiry may not know it yet.
  guests Int?

  // Of those guests, how many are children. The agreement reads "N occupants,
  // dont M enfants", and the split is not only wording: tourist tax generally
  // exempts minors, so a headcount alone bills for people who owe nothing.
  // Counted within `guests`, never on top. A rental has at least one adult, so
  // this is strictly below the headcount — enforced by the
  // `rentals_at_least_one_adult` CHECK as well as by the funnel's schema.
  children Int?

  // Arrival and departure hours for this stay only. Null means the property's
  // own hours, which is what almost every booking means; a value here is an
  // override agreed for this tenant (a late check-out, a dawn arrival) and is
  // what the contract prints.
  checkInTime  String?
  checkOutTime String?

  // How the property was shown before signing. Chosen by the agent, accepted
  // by the tenant's signature — so the contract prints the one that applies
  // rather than three boxes for someone to tick by hand.
  presentation PropertyPresentation @default(REMOTE)

  // grossAmount is the rental revenue. securityDepositAmount is held
  // separately and is never agency revenue — the two must never be
  // conflated. The outstanding balance is derived (gross - deposit),
  // never stored; balanceStatus tracks whether it's been settled.
  //
  // Nullable only while the booking is an enquiry: a client asking about
  // dates has no agreed price yet. A CHECK constraint requires it from
  // BOOKING_CONFIRMATION onwards, with CANCELLED exempt so an enquiry
  // that goes nowhere can still be closed.
  // The owner's net take and the agency commission are the two inputs; the
  // stay amount ("Loyer", grossAmount) is their sum plus any cleaning
  // service marked included. grossAmount stays stored (derived on save) so
  // the balance, commission and payment logic keep working off one figure.
  netOwnerAmount        Decimal? @db.Decimal(12, 2)
  grossAmount           Decimal? @db.Decimal(12, 2)
  depositAmount         Decimal? @db.Decimal(12, 2)
  securityDepositAmount Decimal? @db.Decimal(12, 2)

  // How the acompte was decided. `depositAmount` remains the single figure the
  // documents read; these record the intent behind it, so "half up front"
  // survives a change to the total instead of having to be recomputed by hand.
  // A percentage is resolved into the amount when the funnel saves.
  depositBasis   DepositBasis @default(PERCENT)
  depositPercent Decimal      @default(50) @db.Decimal(5, 2)

  // The agency's share, stored per-rental so the rules can change without
  // rewriting history. Never a hardcoded rate.
  //
  // `commissionAmount` is the resolved figure the loyer and the documents
  // read; `commissionBasis` and `commissionRate` record how it was decided, so
  // "twenty percent" survives a change to the net instead of having to be
  // recomputed by hand.
  commissionAmount Decimal?        @db.Decimal(12, 2)
  commissionBasis  CommissionBasis @default(AMOUNT)
  commissionRate   Decimal?        @db.Decimal(5, 2)

  // Frozen at contract signature, like the owner/agent snapshot: the
  // tourist-tax amount and the per-night rate it was computed with. Null
  // before signing (the tax is then computed live from the city's current
  // rate); authoritative after — a commune revising its rate must never
  // rewrite a signed contract's total.
  touristTaxAmount Decimal? @db.Decimal(12, 2)
  touristTaxRate   Decimal? @db.Decimal(6, 2)

  currency String @default("EUR")

  notes String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([propertyId])
  @@index([ownerId])
  @@index([agentId])
  @@index([tenantAgentId])
  @@index([checkIn, checkOut])
  @@index([bookingStatus])
  @@index([ownerConfirmedAt])
  @@map("rentals")
}

// A rental has one or more tenants; a tenant takes part in many
// rentals. Each linked Contact must hold the CLIENT type — enforced by
// a DB trigger (see migration), same pattern as Property.ownerId.
model RentalTenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId  String   @db.Uuid
  rental    Rental   @relation(fields: [rentalId], references: [id])
  contactId String   @db.Uuid
  contact   Contact  @relation(fields: [contactId], references: [id])
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([rentalId, contactId])
  @@index([contactId])
  @@map("rental_tenants")
}

// An identity document captured during a rental's finalisation. At least
// one per rental, potentially several — a booking may carry four guests
// or more. Linked to the rental, and optionally to which tenant it
// belongs to.
//
// The file itself lives in a private Supabase Storage bucket; only its
// path is stored here. `number` is the document number, not the file.
model IdentityDocument {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Optional: an owner asked for their ID from their contact page has no
  // booking behind it. A tenant's copy still hangs off the rental.
  rentalId String? @db.Uuid
  rental   Rental? @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  // Which guest this belongs to. Nullable and SET NULL on delete: the
  // document is evidence tied to the rental, and must survive a tenant
  // contact being removed from the booking.
  contactId String?  @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Whose document this is: a contact (the tenant, an owner) or an occupant
  // of one stay. Exactly one of the two is set.
  occupantId String?         @db.Uuid
  occupant   RentalOccupant? @relation(fields: [occupantId], references: [id], onDelete: Cascade)

  type        IdentityDocumentType
  // The number as read off the document. Optional: the copy is the evidence,
  // the number only a convenience, and a client may upload without typing it.
  number      String?
  /**
   * When the document was issued. Only meaningful for a registration extract,
   * which must be recent when the contract is signed — a passport is valid or
   * expired on its own terms.
   */
  issuedAt    DateTime? @db.Date
  storagePath String

  uploadedAt   DateTime @default(now())
  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation("IdentityDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([rentalId])
  @@index([contactId])
  @@map("identity_documents")
}

// An extra service on a rental, priced by the agent — distinct from the
// property's own included services (which cost nothing extra). Its amount
// adds to what the client pays, alongside the stay and the tourist tax;
// the stay amount itself is the agent's figure and is never recomputed.
model RentalService {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId String  @db.Uuid
  rental   Rental  @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  label    String
  amount   Decimal @db.Decimal(12, 2)
  // A cleaning line included in the stay amount rolls into grossAmount;
  // otherwise it is an extra billed on top, in the client total.
  includedInStay Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([rentalId])
  @@map("rental_services")
}

// A client's request, before it is a booking. Distinct from a rental: it
// may list several properties, its dates may be open, and it may never
// convert. Converting it creates a Rental (which opens at the
// "Informations" stage); it can also be marked lost.
model Demande {
  id     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mode   DemandeMode
  source DemandeSource @default(DIRECT)

  // The prospect. Their Contact holds the email/phone left to be reached
  // back on — shown alongside the demande.
  contactId String  @db.Uuid
  contact   Contact @relation("DemandeProspect", fields: [contactId], references: [id], onDelete: Restrict)

  // Precise carries definite dates; wide leaves them open. There is never
  // a stay amount here — only a budget, and even that is optional.
  checkIn  DateTime?
  checkOut DateTime?
  guests   Int?
  budget   Decimal?  @db.Decimal(12, 2)
  notes    String?

  // One property for a precise demande, several for a wide one.
  properties DemandeProperty[]

  // An agent sees a demande when every one of its properties is theirs
  // (a precise one they manage, or a wide one entirely theirs). When a
  // wide demande spans several agents' properties, no one qualifies, so
  // an admin assigns it here — and then that agent sees it.
  assignedAgentId String? @db.Uuid
  assignedAgent   User?   @relation("DemandeAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  // Outcome. A rental once converted (that rental opens at Informations),
  // or lost. Neither set means it is still pending.
  convertedRentalId String?   @unique @db.Uuid
  convertedRental   Rental?   @relation("DemandeConversion", fields: [convertedRentalId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?
  lostAt            DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("DemandeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([contactId])
  @@index([convertedAt])
  @@index([lostAt])
  @@index([assignedAgentId])
  @@map("demandes")
}

// The document kinds the agency issues. Extensible — invoices, mandates…
enum DocumentTemplateType {
  RENTAL_CONFIRMATION
  SEASONAL_RENTAL_CONTRACT
}

// One editable template per document type. The content lives in immutable
// versions: editing always creates a new version and moves currentVersion
// forward — generation reads the current version only, older ones are kept
// solely for traceability (a generated document records the version it
// used). The design (fonts, layout, section order and every data table)
// stays in code; the template holds only the legal wording, clause by
// clause, bilingual (FR authoritative, EN courtesy).
model DocumentTemplate {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           DocumentTemplateType @unique
  name           String
  currentVersion Int                  @default(1)

  versions DocumentTemplateVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document_templates")
}

// An immutable snapshot of a template's blocks. Never updated, never
// deleted — the audit trail of what every generated document was built
// from.
model DocumentTemplateVersion {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String           @db.Uuid
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  // The template's clauses: a map of clause key -> bilingual paragraphs
  // (see features/documents/template-clauses.ts). Only the legal wording is
  // editable; composition and layout stay in the template components. The
  // column keeps its original name.
  blocks     Json

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  createdBy   User?    @relation("TemplateVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([templateId, version])
  @@map("document_template_versions")
}

// A document actually produced for a rental, and the file it wrote.
//
// Immutable, and never overwritten: regenerating adds a row. A confirmation
// or a contract may have been sent, signed, or relied on, so the question
// "what exactly did the client receive on the 12th" has to stay answerable —
// which it would not be if a later generation replaced the file in place.
// That is also why the wording's version is recorded: the clauses can be
// edited afterwards, and this pins which ones produced this document.
model GeneratedDocument {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId String @db.Uuid
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  type DocumentTemplateType

  // The reference as printed on the document ("RC-0001240"), and the file
  // name it was stored under. Both are snapshots: the rental's reference
  // cannot change, but the tenant's name can, and the stored file keeps the
  // name it was written with.
  reference String
  fileName  String

  // Object key in the private `generated-documents` bucket. Unique because
  // each generation writes its own object — nothing is ever replaced.
  storagePath String @unique

  // Which template version supplied the wording. Null when the document was
  // generated from the wording shipped in code, before any template was
  // saved — a real state, not a missing value.
  templateVersion Int?

  generatedById String? @db.Uuid
  generatedBy   User?   @relation("GeneratedDocumentAuthor", fields: [generatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([rentalId, type, createdAt])
  @@map("generated_documents")
}

// What came back with signatures on it.
//
// GeneratedDocument records what the agency produced; this records what the
// parties actually signed — the copy that counts if the booking is ever
// disputed. Append-only for the same reason: a second upload of a type
// supersedes the previous one and both stay, so replacing a signed document
// always leaves a trace.
/**
 * Whether an upload is the signed copy of a document or an amendment to it.
 *
 * An avenant does not replace what it amends — both stay in force — so it is a
 * second axis rather than another upload of the same kind, which would
 * supersede the copy it modifies.
 */
enum SignedDocumentKind {
  SIGNED
  AMENDMENT
}

/**
 * Another adult on the stay. Recorded, not taken on as a client: they change
 * every booking, and the address book already holds 5000 APIMO records.
 * Children are excluded, by the same rule that exempts them from the tax.
 */
/**
 * A sum recorded against one of the three amounts a booking carries.
 *
 * Immutable once saved: never edited, never deleted. A mistake is corrected by
 * a further entry that offsets it, so the trail shows both the error and its
 * correction — which is what the financial register this feeds requires, and
 * why an amount may be negative.
 *
 * The deposit going back to the client is still the
 * `securityDepositReturnedAt` milestone: a different event, with a date and a
 * meaning of its own.
 */
/**
 * Something on the calendar that no booking records.
 *
 * A caretaker's visit, a pool service, an owner staying in their own villa, a
 * viewing. Both links are optional: an agency meeting belongs to no villa, and
 * an event about a booking points at it without pretending to be one.
 */
model CalendarEvent {
  id    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title String
  kind  CalendarEventKind @default(OTHER)

  /** Day-granular, and `endsOn` is inclusive: a one-day event repeats its date. */
  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date

  propertyId String?   @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentalId   String?   @db.Uuid
  rental     Rental?   @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  notes String?

  createdById String? @db.Uuid
  createdBy   User?   @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsOn, endsOn])
  @@index([propertyId])
  @@map("calendar_events")
}

model RentalPayment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId String @db.Uuid
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  kind RentalPaymentKind
  /** Negative for a correction offsetting an earlier entry. Never zero. */
  amount Decimal   @db.Decimal(12, 2)
  /** Null while the agent knows it landed but not on what day. */
  paidAt DateTime? @db.Date
  /** "virement", "chèque n° …" — whatever makes it findable on a statement. */
  note   String?

  recordedById String? @db.Uuid
  recordedBy   User?   @relation("RentalPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([rentalId, kind])
  @@map("rental_payments")
}

/**
 * A cost incurred during the stay, and who carries it.
 *
 * Immutable once saved, like the payments: these are financial movements, and
 * a correction is a further entry offsetting the first rather than an edit —
 * hence amounts that may be negative and never zero.
 */
model RentalExpense {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId String @db.Uuid
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  label  String
  /** Negative for a correction offsetting an earlier entry. Never zero. */
  amount Decimal       @db.Decimal(12, 2)
  bearer ExpenseBearer
  spentAt DateTime?    @db.Date

  /** The receipt, when there is one — it often arrives after the expense. */
  storagePath String?
  fileName    String?

  recordedById String? @db.Uuid
  recordedBy   User?   @relation("RentalExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([rentalId, bearer])
  @@map("rental_expenses")
}

model RentalOccupant {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId String @db.Uuid
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  idDocType   IdentityDocumentType?
  idDocNumber String?

  identityDocuments IdentityDocument[]

  createdAt DateTime @default(now())

  @@index([rentalId])
  @@map("rental_occupants")
}

/**
 * A link a client fills in themselves.
 *
 * Targets a contact; the rental is only context — opened from a contact page
 * it is an identity request, from Finalisation it also asks the motif and the
 * occupants. The token is the whole credential, so it is long, random, expiring
 * and revocable, and it reaches exactly one contact.
 */
model ClientIntakeLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  contactId String   @db.Uuid
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  rentalId  String?  @db.Uuid
  rental    Rental?  @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  /** Whether this asks for the tenant's own identity or only the occupants. */
  scope IntakeScope @default(FULL)

  createdById String? @db.Uuid
  createdBy   User?   @relation("IntakeLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  /** Last answered. Stays usable until it expires so a mistake can be fixed. */
  submittedAt DateTime?

  submissions ClientIntakeSubmission[]

  @@index([contactId])
  @@index([rentalId])
  @@map("client_intake_links")
}

/**
 * What a client declared, and when.
 *
 * Append-only. The contact holds what is true now; this holds what was stated
 * at the time, which is what an inspection asks for and what updating the
 * contact would destroy.
 */
model ClientIntakeSubmission {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  linkId    String            @db.Uuid
  link      ClientIntakeLink  @relation(fields: [linkId], references: [id], onDelete: Cascade)
  contactId String            @db.Uuid
  contact   Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  rentalId  String?           @db.Uuid
  rental    Rental?           @relation(fields: [rentalId], references: [id], onDelete: SetNull)

  /** Exactly what was submitted, kept whole so it survives schema changes. */
  payload Json

  confirmedAt DateTime
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
  @@index([rentalId])
  @@map("client_intake_submissions")
}

model SignedDocument {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId String @db.Uuid
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  type DocumentTemplateType
  kind SignedDocumentKind @default(SIGNED)

  // The name as uploaded — kept for the download and for telling two scans
  // apart. Storage keys stay opaque.
  fileName  String
  mimeType  String
  sizeBytes Int

  // Object key in the private `signed-documents` bucket. Unique because each
  // upload writes its own object; nothing is ever overwritten.
  storagePath String @unique

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation("SignedDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  uploadedAt DateTime @default(now())

  @@index([rentalId, type, kind, uploadedAt])
  @@map("signed_documents")
}

/**
 * The agency's own record: what every document prints about BSTAY itself.
 *
 * A single row — `id` is fixed at 1 by a CHECK — because there is one agency.
 * It replaces a block of constants in code, which meant the footer's address
 * could only be corrected by a deploy, and had drifted: the documents printed
 * Saint-Tropez while the Figma masters said Cannes.
 *
 * Editing needs MANAGE_AGENCY. The bank details are the reason that is its own
 * permission rather than MANAGE_USERS: whoever can change them changes where
 * every tenant sends their money.
 */
model Agency {
  id Int @id @default(1)

  // Identity as it appears in the masthead and the parties clause.
  name        String
  tagline     String
  legalName   String
  legalForm   String
  capital     String
  address     String
  rcs         String
  cartePro    String
  garantieFinanciere String
  rcp         String
  web         String
  phone       String

  // Who signs, and in what capacity.
  representedBy String
  capacity      String

  // Printed in the agreement's transfer details. See the security notice
  // beside them in the document: a change arriving by email is precisely the
  // fraud that warns against, so these are edited here and nowhere else.
  bankName        String
  bankAccountName String
  bankIban        String
  bankBic         String

  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("AgencyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("agency")
}

// A property a demande is interested in. Many for a wide demande, one for
// a precise one.
model DemandeProperty {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  demandeId  String   @db.Uuid
  demande    Demande  @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([demandeId, propertyId])
  @@index([propertyId])
  @@map("demande_properties")
}
