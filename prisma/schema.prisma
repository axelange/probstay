// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  AGENT
}

enum Permission {
  MANAGE_USERS
  MANAGE_CONTACTS
  MANAGE_PROPERTIES
  MANAGE_RENTALS
  MANAGE_INVOICES
  MANAGE_REGISTERS
  VIEW_FINANCIALS
}

// The booking pipeline. Terminal states are CHECK_OUT and CANCELLED.
// The deposit / security deposit / balance stage isn't here — those
// three settle independently of the booking's progress, so they're
// tracked as separate payment statuses on Rental.
// The booking pipeline. Two hard gates, both an explicit checkbox: the
// tri-party agreement lets INQUIRY become CONTRACT (and locks the
// dates), and the signed contract lets CONTRACT become FINALISATION (and
// freezes the owner/agent snapshot). Everything past that is guided, not
// walled — the UI shows what is missing without blocking.
//
// FINALISATION holds the identity documents and the payments. CHECK_IN
// is the stay itself, where services are billed and documents attached
// (later phases). After CHECK_OUT one thing remains: the security
// deposit returned. CANCELLED is reachable from any stage.
//
// Replaces the earlier BOOKING_CONFIRMATION stage (now the gate
// checkbox) and KYC stage (now identity capture inside FINALISATION).
enum RentalBookingStatus {
  INQUIRY
  CONTRACT
  FINALISATION
  CHECK_IN
  CHECK_OUT
  CANCELLED
}

enum IdentityDocumentType {
  PASSPORT
  ID_CARD
  DRIVING_LICENSE
}

// A demande (request) is its own thing, distinct from a rental: the first
// contact from a client, which may never turn into a booking. A precise
// demande names one property with definite dates; a wide one lists
// several properties of interest, dates optional. It carries a budget,
// never a stay amount — that belongs to the rental it may become.
enum DemandeMode {
  PRECISE
  WIDE
}

// Where the request came from. Filled automatically, not chosen: direct
// when we create it ourselves, website when it arrives from the site.
enum DemandeSource {
  DIRECT
  WEBSITE
}

// Tourist tax (taxe de séjour) rate per commune, in euros per person per
// night. Reference data an Admin revises about once a year, matched to a
// property by its city name. Kept as its own table rather than a config
// blob so each rate carries who changed it and when.
model TouristTax {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city          String   @unique
  amount        Decimal  @db.Decimal(6, 2)
  updatedAt     DateTime @updatedAt
  updatedById   String?  @db.Uuid
  updatedBy     User?    @relation("TouristTaxUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("tourist_taxes")
}

enum RentalPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

// Only OWNER contacts may be linked as a Property's owner (enforced by
// a DB trigger, see migration). Partner/Provider are purely
// informational — used later for invoice generation, no relations yet.
// CLIENT is the business "Tenant" (the customer renting a property) —
// same concept, this is the Contact-system term for it.
// A Contact can hold more than one type at once (e.g. an Owner who is
// also a Client) — see Contact.types.
enum ContactType {
  OWNER
  CLIENT
  PARTNER
  PROVIDER
  // A prospect is someone who has only made a request and is nothing
  // else yet — not an owner, client, partner or provider. It is therefore
  // exclusive: a contact holding PROSPECT holds no other type (enforced
  // by a CHECK). On conversion of their demande they become a CLIENT.
  PROSPECT
}

// What a contact actually does. `types` says how they relate to BSTAY;
// this says their trade, which "Prestataire" alone cannot distinguish —
// a cleaner and a bailiff are not interchangeable.
//
// Identifiers are English, labels French, per the coding guidelines
// (see contact-specialty-labels.ts).
//
// Deliberately not restricted to PROVIDER: BUSINESS_INTRODUCER
// describes a Partner, not a supplier.
//
// OTHER is paired with `otherSpecialty` free text. It exists so an
// unlisted trade is recorded rather than lost in a notes field, without
// a migration for every new one.
enum ContactSpecialty {
  CLEANING
  BAILIFF
  DESIGN
  ARCHITECT
  PLUMBING
  ELECTRICAL
  HVAC
  CONSTRUCTION
  BUSINESS_INTRODUCER
  ACCOUNTING
  EVENTS
  CATERING
  TRANSPORT
  OTHER
}

// id matches the corresponding auth.users.id (Supabase Auth) — set
// explicitly when the profile is created, never auto-generated here.
model User {
  id              String           @id @db.Uuid
  email           String           @unique
  fullName        String
  role            Role
  permissions     UserPermission[]
  properties            Property[]         @relation("PropertyAgent")
  rentalsHandled        Rental[]           @relation("RentalAgent")
  rentalsOwnerConfirmed Rental[]           @relation("RentalOwnerConfirmedBy")
  rentalsContractSigned Rental[]           @relation("RentalContractSignedBy")
  identityDocuments     IdentityDocument[] @relation("IdentityDocumentUploader")
  touristTaxesUpdated   TouristTax[]       @relation("TouristTaxUpdatedBy")
  demandesCreated       Demande[]          @relation("DemandeCreatedBy")
  invitationsSent       UserInvitation[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?

  @@map("users")
}

// Access to the whole application is invite-only: an email with no row
// here cannot even authenticate (enforced by the before-user-created
// auth hook). On first Google sign-in a trigger consumes the matching
// invitation and creates the User profile with the role named here.
//
// This is a separate table rather than a pre-created User row because
// User.id must equal auth.users.id, which doesn't exist until the
// person actually signs in for the first time.
//
// Gating auth on the invitation (rather than on the email domain) is
// what keeps invite and sign-in correctly ordered: if someone could
// authenticate first and be invited afterwards, the provisioning
// trigger would already have run and their invitation would never be
// consumed, stranding them with no profile.
model UserInvitation {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @unique
  role  Role

  // Staff invitations must be @b-stay.com (enforced by a CHECK).
  // isExternal exempts an address from that rule — for the developer,
  // who is not on the company Workspace. Only SUPER_ADMIN may create
  // one (enforced by RLS), so a second dev is a row, not a redeploy.
  isExternal Boolean @default(false)

  invitedBy String? @db.Uuid
  inviter   User?   @relation(fields: [invitedBy], references: [id])

  // Informational once set: the hook only ever runs on first sign-in,
  // so a consumed invitation still needs to exist for later logins.
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_invitations")
}

// Per-user grant/revoke overrides on top of a Role's baseline
// capabilities (enforced in server code). Lets an Admin adjust a
// Moderator's or Agent's access without a migration.
model UserPermission {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id])
  permission Permission
  granted    Boolean    @default(true)
  createdAt  DateTime   @default(now())

  @@unique([userId, permission])
  @@map("user_permissions")
}

model Contact {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Multi-valued: the same Contact can hold more than one type at once
  // (e.g. an Owner who is also a Client). Plain array instead of a
  // join table so reading a Contact's types never needs a second query.
  types ContactType[]

  // Trade(s). Multi-valued because one contact routinely does more than
  // one thing — the first real record created was "Graphiste /
  // Développeur web". Same array-over-join-table reasoning as `types`.
  specialties ContactSpecialty[]

  // Free text, only meaningful when `specialties` contains OTHER.
  otherSpecialty String?

  // `apimoId` is the identity for anything synced from APIMO; contacts
  // created in BSTAY simply have none.
  apimoId Int? @unique

  // lastName is the only name guaranteed present: it is set on all 5052
  // APIMO contacts, whereas 730 carry no first name — surname-only and
  // company records are normal here, not corruption.
  firstName String?
  lastName  String

  // Nullable because the agency's records are genuinely incomplete: 14
  // of the 46 owners of our properties have no email, and 16 have no
  // number. Requiring either would silently leave those properties
  // owner-less, which is worse than holding a partial contact. The
  // agency is filling the gaps at source; this stops the schema being
  // the thing that blocks import meanwhile.
  //
  // email keeps its unique index — no two owners share an address, and
  // Postgres does not treat NULLs as conflicting, so the incomplete
  // records coexist happily. Revisit if the sync ever widens past
  // owners to the full CRM, where 201 addresses are shared.
  email String? @unique
  phone String?
  iban          String?
  notes         String?
  properties        Property[]
  rentalsOwned      Rental[]
  rentalTenants     RentalTenant[]
  identityDocuments IdentityDocument[]
  demandes          Demande[]          @relation("DemandeProspect")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?

  // Supports the 'CLIENT' = any(types) lookup used by the Agent
  // contact-visibility RLS policy.
  @@index([types], map: "contacts_types_gin_idx", type: Gin)
  // Same shape of lookup: "every plumber" is an = ANY(specialties) scan.
  @@index([specialties], map: "contacts_specialties_gin_idx", type: Gin)
  @@map("contacts")
}

model Property {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apimoId       Int?   @unique
  reference     Int?
  apimoAgencyId Int?

  // BSTAY's own name for the property — the one clients are shown ("Villa
  // Alba"), as opposed to APIMO's reference. The only field on this model
  // that doesn't come from APIMO, so the sync must never overwrite it.
  // Unique: two properties sharing a name would make them
  // indistinguishable to a client.
  marketingName String? @unique

  // Nullable: real APIMO data commonly has no owner assigned yet
  // (all 52 sampled step=1 properties had owner: null).
  // Must reference a Contact with type = OWNER — enforced by a DB
  // trigger (see migration), not a plain FK, since Postgres can't
  // constrain "FK to a row with a specific column value" natively.
  ownerId String?  @db.Uuid
  owner   Contact? @relation(fields: [ownerId], references: [id])

  // Our own User FK, resolved separately (e.g. by matching email)
  // since APIMO's `user.id` is a different ID space than our UUIDs.
  agentId      String? @db.Uuid
  agent        User?   @relation("PropertyAgent", fields: [agentId], references: [id])
  apimoAgentId Int?

  // Classification (APIMO reference codes — see api3.apimo.com referentiel)
  category    Int?
  subcategory Int?
  type        Int?
  subtype     Int?
  status      Int?
  step        Int?
  quality     Int?
  name        String?

  // Address / location
  address         String?
  addressMore     String?
  publishAddress  Boolean @default(false)
  country         String?
  region          String?
  regionApimoId   Int?
  city            String?
  cityApimoId     Int?
  zipcode         String?
  district        String?
  districtApimoId Int?
  latitude        Float?
  longitude       Float?
  altitude        Int?

  // Size
  areaValue Float?
  areaUnit  Int?
  areaTotal Float?
  rooms     Int?
  bedrooms  Int?
  sleeps    Int?

  // APIMO has no bathroom count. It's derived during the sync from the
  // property's areas[] and, failing that, from its descriptions — the
  // same derivation the public site uses, so both agree. Stored rather
  // than computed on read: it's expensive (regex over long descriptions)
  // and must not drift between the two systems.
  bathrooms Int?

  // Pricing
  //
  // A null priceValue is not missing data: APIMO shows those as "price on
  // demand", and the agency means it. Distinct from priceHidden, which is
  // APIMO's `price.hide` — a rate that exists but must not be published.
  // Staff see it in the ERP; anything public (the planned website API)
  // must honour the flag.
  priceValue      Decimal? @db.Decimal(12, 2)
  priceMax        Decimal? @db.Decimal(12, 2)
  priceCurrency   String?
  pricePeriod     Int?
  priceHidden     Boolean  @default(false)
  priceCommission Decimal? @db.Decimal(12, 2)
  priceDeposit    Decimal? @db.Decimal(12, 2)
  priceFees       Decimal? @db.Decimal(12, 2)

  // Condition / construction
  condition        Int?
  standing         Int?
  constructionYear Int?
  renovationYear   Int?

  // Availability
  availability String?
  availableAt  DateTime?
  deliveredAt  DateTime?

  // APIMO reference-code arrays (resolved to labels via the
  // referentiel lookup when needed, not stored as text here)
  services    Int[]

  // Services included with a stay, shown on the rental as "services
  // inclus". BSTAY's own field — plain labels typed by the agency, not
  // APIMO's `services` codes above (pool, aircon…). The sync never
  // writes this, so it survives every re-sync, like `marketingName`.
  includedServices String[]

  demandeProperties DemandeProperty[]
  proximities Int[]
  tags        Int[]

  url String?

  // French only. APIMO has no description field — the text lives in
  // comments[], one entry per language (en/fr/bg/ru), and the sync takes
  // the French one. Null rather than another language if French is
  // missing. If the other languages are ever needed (the public-site API,
  // an owner or tenant portal), this becomes a one-to-many table.
  description String?

  notes String?

  pictures PropertyPicture[]
  rentals  Rental[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@map("properties")
}

model PropertyPicture {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  apimoId    Int      @unique
  rank       Int?
  url        String
  widthMax   Int?
  heightMax  Int?
  isPanorama Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("property_pictures")
}

// The central business object — nothing financial exists outside a
// Rental. Created in the app (agents set up bookings); not synced from
// APIMO, hence no apimoId.
model Rental {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])

  // Owner of record for this rental, snapshotted from the property when
  // the lease is signed (bookingStatus reaches CONTRACT) — at that
  // moment it matches the real signed document. Null before then: the
  // booking is still an enquiry or awaiting the owner, and the property
  // may yet be reassigned. Deliberately not read through property.ownerId
  // afterwards: if a property later changes hands, past rentals must
  // stay attributed to the owner they actually belonged to, or
  // historical Owner Statements silently rewrite themselves.
  // onDelete: Restrict — a snapshot that can be nulled is not a
  // snapshot. Business rules are soft-delete-only so this should never
  // fire, but a stray hard DELETE would otherwise blank the owner on
  // every past rental at once. rentals.propertyId already restricts for
  // the same reason.
  ownerId String?  @db.Uuid
  owner   Contact? @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  // Agent of record, snapshotted from the property alongside ownerId
  // when the lease is signed (CONTRACT) — same moment, same reasoning.
  // Reassigning a property must not rewrite who handled every past
  // rental of it, which is what commission is attributed against.
  //
  // This is attribution, not authorisation: who may still *edit* a
  // rental follows the property's current agent (see the rentals RLS
  // policies), because an agent taking over a property has to be able
  // to manage its in-flight bookings.
  //
  // Nullable: null until CONTRACT, and a property may have no agent even
  // then. Captured by the rentals service (see utils/rental-snapshot) —
  // there is no trigger doing it.
  agentId String? @db.Uuid
  agent   User?   @relation("RentalAgent", fields: [agentId], references: [id], onDelete: Restrict)

  tenants RentalTenant[]

  // First stage is INQUIRY, labelled "Informations" in the UI: a rental
  // only exists once a demande has been converted into one, so its
  // opening stage is where the booking's information is completed before
  // the contract. (The request phase lives on the Demande entity.)
  bookingStatus RentalBookingStatus @default(INQUIRY)

  // The demande this rental was converted from, if any. The FK lives on
  // Demande (convertedRentalId); this is only the back-relation.
  originatingDemande Demande? @relation("DemandeConversion")

  // When the owner confirmed these dates, and who obtained it.
  //
  // Recorded separately from bookingStatus because BOOKING_CONFIRMATION
  // covers two different situations — "asked the owner" and "the owner
  // said yes" — and only the second is exclusive. Mandates are not
  // exclusive, so several agents may legitimately be waiting on the same
  // owner for the same week; what may not happen twice is the answer.
  //
  // This is what the no-overlap constraint keys on, not the deposit:
  // waiting for payment would lock the villa long after promises have
  // been made. It is also the agency's evidence if an owner later
  // disputes having agreed — a date and a name, not an inferred status.
  ownerConfirmedAt   DateTime?
  ownerConfirmedById String?   @db.Uuid
  ownerConfirmedBy   User?     @relation("RentalOwnerConfirmedBy", fields: [ownerConfirmedById], references: [id], onDelete: Restrict)

  // The "contract signed by all parties" gate. This is the moment the
  // booking matches a real signed document, so it — not entry into the
  // CONTRACT stage — is when the owner/agent snapshot is frozen.
  contractSignedAt   DateTime?
  contractSignedById String?   @db.Uuid
  contractSignedBy   User?     @relation("RentalContractSignedBy", fields: [contractSignedById], references: [id], onDelete: Restrict)

  // The one thing left after check-out: the security deposit handed back.
  // Sets securityDepositStatus to REFUNDED in the same action.
  securityDepositReturnedAt DateTime?

  identityDocuments IdentityDocument[]
  // Extra services the agent adds and prices for this booking, on top of
  // the stay amount and the property's own included services.
  services          RentalService[]

  // Deposit, security deposit and balance settle independently of each
  // other and of the booking's stage, so each carries its own status.
  depositStatus         RentalPaymentStatus @default(UNPAID)
  securityDepositStatus RentalPaymentStatus @default(UNPAID)
  balanceStatus         RentalPaymentStatus @default(UNPAID)

  checkIn  DateTime
  checkOut DateTime

  // Number of guests the booking is for — not the number of named
  // tenants (a party of eight may have one lead contact). Drives the
  // tourist tax, which is charged per person per night. Nullable: an
  // enquiry may not know it yet.
  guests Int?

  // grossAmount is the rental revenue. securityDepositAmount is held
  // separately and is never agency revenue — the two must never be
  // conflated. The outstanding balance is derived (gross - deposit),
  // never stored; balanceStatus tracks whether it's been settled.
  //
  // Nullable only while the booking is an enquiry: a client asking about
  // dates has no agreed price yet. A CHECK constraint requires it from
  // BOOKING_CONFIRMATION onwards, with CANCELLED exempt so an enquiry
  // that goes nowhere can still be closed.
  grossAmount           Decimal? @db.Decimal(12, 2)
  depositAmount         Decimal? @db.Decimal(12, 2)
  securityDepositAmount Decimal? @db.Decimal(12, 2)

  // Resolved output of the commission engine, stored per-rental so the
  // rules can change without rewriting history. Never a hardcoded rate.
  commissionAmount Decimal? @db.Decimal(12, 2)
  commissionRate   Decimal? @db.Decimal(5, 2)

  currency String @default("EUR")

  notes String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([propertyId])
  @@index([ownerId])
  @@index([agentId])
  @@index([checkIn, checkOut])
  @@index([bookingStatus])
  @@index([ownerConfirmedAt])
  @@map("rentals")
}

// A rental has one or more tenants; a tenant takes part in many
// rentals. Each linked Contact must hold the CLIENT type — enforced by
// a DB trigger (see migration), same pattern as Property.ownerId.
model RentalTenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId  String   @db.Uuid
  rental    Rental   @relation(fields: [rentalId], references: [id])
  contactId String   @db.Uuid
  contact   Contact  @relation(fields: [contactId], references: [id])
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([rentalId, contactId])
  @@index([contactId])
  @@map("rental_tenants")
}

// An identity document captured during a rental's finalisation. At least
// one per rental, potentially several — a booking may carry four guests
// or more. Linked to the rental, and optionally to which tenant it
// belongs to.
//
// The file itself lives in a private Supabase Storage bucket; only its
// path is stored here. `number` is the document number, not the file.
model IdentityDocument {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId String @db.Uuid
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  // Which guest this belongs to. Nullable and SET NULL on delete: the
  // document is evidence tied to the rental, and must survive a tenant
  // contact being removed from the booking.
  contactId String?  @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  type        IdentityDocumentType
  number      String
  storagePath String

  uploadedAt   DateTime @default(now())
  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation("IdentityDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([rentalId])
  @@index([contactId])
  @@map("identity_documents")
}

// An extra service on a rental, priced by the agent — distinct from the
// property's own included services (which cost nothing extra). Its amount
// adds to what the client pays, alongside the stay and the tourist tax;
// the stay amount itself is the agent's figure and is never recomputed.
model RentalService {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rentalId String  @db.Uuid
  rental   Rental  @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  label    String
  amount   Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([rentalId])
  @@map("rental_services")
}

// A client's request, before it is a booking. Distinct from a rental: it
// may list several properties, its dates may be open, and it may never
// convert. Converting it creates a Rental (which opens at the
// "Informations" stage); it can also be marked lost.
model Demande {
  id     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mode   DemandeMode
  source DemandeSource @default(DIRECT)

  // The prospect. Their Contact holds the email/phone left to be reached
  // back on — shown alongside the demande.
  contactId String  @db.Uuid
  contact   Contact @relation("DemandeProspect", fields: [contactId], references: [id], onDelete: Restrict)

  // Precise carries definite dates; wide leaves them open. There is never
  // a stay amount here — only a budget, and even that is optional.
  checkIn  DateTime?
  checkOut DateTime?
  guests   Int?
  budget   Decimal?  @db.Decimal(12, 2)
  notes    String?

  // One property for a precise demande, several for a wide one.
  properties DemandeProperty[]

  // Outcome. A rental once converted (that rental opens at Informations),
  // or lost. Neither set means it is still pending.
  convertedRentalId String?   @unique @db.Uuid
  convertedRental   Rental?   @relation("DemandeConversion", fields: [convertedRentalId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?
  lostAt            DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("DemandeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([contactId])
  @@index([convertedAt])
  @@index([lostAt])
  @@map("demandes")
}

// A property a demande is interested in. Many for a wide demande, one for
// a precise one.
model DemandeProperty {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  demandeId  String   @db.Uuid
  demande    Demande  @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([demandeId, propertyId])
  @@index([propertyId])
  @@map("demande_properties")
}
