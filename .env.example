# Copy to .env.local and fill in real values. Never commit .env.local.

# Prisma — DIRECT_URL for CLI/migrations (port 5432), DATABASE_URL for app runtime (port 6543, pooled)
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# APIMO sync runs entirely inside Supabase (Vault + Edge Function +
# Cron) — the app never talks to APIMO directly, so no APIMO vars here.
